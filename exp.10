import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.svm import SVC
from sklearn.metrics import classification_report,accuracy_score
data=pd.read_csv(r"C:\Users\lenovo\Downloads\survey_lung_cancer_SVM.csv")
bin_map={
    'M':1,'F':0,
    'MALE':1,'FEMALE':0,
    'YES':1,'NO':0
}
for col in data.columns:
    if data[col].dtype==object:
        data[col]=data[col].map(lambda x:bin_map.get(x,x))
        try:
            data[col]=pd.to_numeric(data[col])
        except ValueError:
            pass
    corrmat=data.corr(numeric_only=True)
    plt.figure(figsize=(12, 8))
    sns.heatmap(corrmat,annot=True,fmt='.2f',cmap='RdYlGn')
    plt.show()
    X=data.drop(columns=['LUNG_CANCER']).select_dtypes(include=['number'])
    y=data['LUNG_CANCER']
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    x_train,x_test,y_train,y_test=train_test_split(X_scaled,y,test_size=0.2,random_state=42)
    sv=SVC()
    sv.fit(x_train,y_train)
    y_pred=sv.predict(x_test)
    print("Classification report:\n",classification_report(y_test,y_pred))
    print("Accuracy:",accuracy_score(y_test,y_pred))